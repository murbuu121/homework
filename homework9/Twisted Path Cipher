def twisted_path_encipher(message, rows, cols, path):
    """Enciphers a message using a predefined path of tuples."""
    padded = message.ljust(rows * cols, 'X')
    
    # Populate grid
    grid = [["" for _ in range(cols)] for _ in range(rows)]
    idx = 0
    for r in range(rows):
        for c in range(cols):
            grid[r][c] = padded[idx]
            idx += 1
            
    # Read characters along the path
    ciphertext = ""
    for pos in path:
        r, c = pos
        ciphertext += grid[r][c]
        
    return ciphertext

