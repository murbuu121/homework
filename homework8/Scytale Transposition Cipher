def encipher_scytale(message, rows):
    cols = len(message) // rows
    # Re-organize into a grid of rows
    grid = [message[i * cols:(i + 1) * cols] for i in range(rows)]
    # Read down columns
    ciphertext = "".join(grid[r][c] for c in range(cols) for r in range(rows))
    return ciphertext

def decipher_scytale(ciphertext, rows):
    cols = len(ciphertext) // rows
    # Reconstruct the column-based grid
    grid_cols = [ciphertext[i * rows:(i + 1) * rows] for i in range(cols)]
    # Read across rows
    plaintext = "".join(grid_cols[c][r] for r in range(rows) for c in range(cols))
    return plaintext
