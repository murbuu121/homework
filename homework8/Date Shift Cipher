def encode_date_shift(message, date_str):
    encoded = []
    date_len = len(date_str)
    for i, char in enumerate(message):
        if char.isalpha():
            shift = int(date_str[i % date_len])
            base = ord('A') if char.isupper() else ord('a')
            new_char = chr((ord(char) - base + shift) % 26 + base)
            encoded.append(new_char)
        else:
            encoded.append(char)
    return "".join(encoded)

def decode_date_shift(message, date_str):
    decoded = []
    date_len = len(date_str)
    for i, char in enumerate(message):
        if char.isalpha():
            shift = int(date_str[i % date_len])
            base = ord('A') if char.isupper() else ord('a')
            new_char = chr((ord(char) - base - shift) % 26 + base)
            decoded.append(new_char)
        else:
            decoded.append(char)
    return "".join(decoded)
